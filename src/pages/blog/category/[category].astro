---
// Category archive: /blog/category/<slug>, e.g. /blog/category/technology.
//
// Generated ONLY from the `category` string in real blog frontmatter —
// no category files are invented (the `categories` collection stays
// schema-only; see CONTENT_SCHEMA.md). One page per distinct category
// across the 20 posts (5 categories). Posts are listed newest-first,
// using the same BlogCard grid as the blog index. No pagination: the
// largest archive (Technology) holds 12 posts on one page.
// NOTE: there is no /blog/tag/[tag] page — no post sets `tags`, so there
// is no real tag value to generate a page from.
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BlogCard from "@/components/BlogCard.astro";
import MainContainer from "@/components/MainContainer.astro";
import { getSingleEntry } from "@/lib/contentParser";
import { categorySlug, postSlug } from "@/lib/blogUrls";
import { getListPage } from "@/lib/contentParser";
import { breadcrumbJsonLd } from "@/lib/seo";
import { sortEntriesByDate } from "@/lib/utils/sortFunctions";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";

export async function getStaticPaths() {
  const posts = await getSingleEntry("blog");
  const byCategory = new Map<string, typeof posts>();
  for (const post of posts) {
    const category = post.data.category;
    if (!category) continue;
    const list = byCategory.get(category) ?? [];
    list.push(post);
    byCategory.set(category, list);
  }
  return [...byCategory.entries()].map(([category, categoryPosts]) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      posts: sortEntriesByDate(categoryPosts).map((post) => ({
        frontmatter: post.data,
        slug: postSlug(post),
        content: post.body || "",
      })),
    },
  }));
}

const { category, posts } = Astro.props;
const count = posts.length;
const page_header = {
  title: category,
  badge: "Category",
  subtitle: `${count} ${count === 1 ? "post" : "posts"} in ${category}`,
};
const callToAction = await getListPage("sections/call-to-action.md");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: `Category: ${category}` },
];
---

<Base
  title={`${category} — Category`}
  description={page_header.subtitle}
  jsonLd={breadcrumbJsonLd(breadcrumbs)}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHeader page_header={page_header} />
  <section>
    <MainContainer>
      <div class="container-padding-x container-padding-y">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-2.5 mb-10">
          {posts.map((post) => (
            <div>
              <BlogCard data={post} />
            </div>
          ))}
        </div>
      </div>
    </MainContainer>
  </section>
  <CallToAction data={callToAction} />
</Base>
