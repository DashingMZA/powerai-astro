---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import FAQ from "@/partials/FAQ";
import PageHeader from "@/partials/PageHeader.astro";
import TrustedClients from "@/partials/TrustedClients";
import PricingSection from "@/partials/Pricing";
import PricingTable from "@/components/PricingTable";
import { getListPage } from "@/lib/contentParser";
import type { FAQPageData } from "@/partials/FAQ";
import type { PricingPageData } from "@/partials/Pricing";
import type { IndexFrontmatter, LogoMarqueeType } from "@/types/index";

const data = await getListPage<IndexFrontmatter>("pricing/-index.md");
const { title, description, meta_title, image, page_header, pricing_table } =
  data.frontmatter;
const trusted_clients = await getListPage<LogoMarqueeType>(
  "sections/trusted-clients.md",
);
const pricing = await getListPage<PricingPageData["frontmatter"]>(
  "sections/pricing.md",
);
const faq = await getListPage<FAQPageData["frontmatter"]>("sections/faq.md");
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader page_header={page_header}>
    <PricingSection data={pricing} isHome={false} client:visible />
  </PageHeader>
  <TrustedClients data={trusted_clients} client:load />
  <PricingTable data={pricing_table} client:visible />
  <FAQ data={faq} client:visible />
  <CallToAction data={callToAction} />
</Base>
