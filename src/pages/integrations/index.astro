---
import Base from "@/layouts/Base.astro";
import IntegrationList from "@/components/IntegrationList";
import CallToAction from "@/partials/CallToAction.astro";
import FAQ from "@/partials/FAQ.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser";
import { breadcrumbJsonLd, canonicalUrl, webPageJsonLd } from "@/lib/seo";
import type { FAQPageData } from "@/partials/FAQ.astro";
import type { IndexFrontmatter, IntegrationType } from "@/types/index";

const integrationIndex = await getListPage<IndexFrontmatter>(
  "integrations/-index.md",
);
const { title, description, meta_title, image, page_header } =
  integrationIndex.frontmatter;
const integrationItems = await getSinglePage<IntegrationType>("integrations");
const faq = await getListPage<FAQPageData["frontmatter"]>("sections/faq.md");
const callToAction = await getListPage("sections/call-to-action.md");
const canonical = canonicalUrl(Astro.url.pathname);
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Integrations" }];
const pageJsonLd = [
  webPageJsonLd({
    type: "CollectionPage",
    name: title,
    description,
    canonical,
  }),
  breadcrumbJsonLd(breadcrumbs),
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  jsonLd={pageJsonLd}
>
  <PageHeader page_header={page_header} />
  <IntegrationList items={integrationItems} client:load />
  <FAQ data={faq} />
  <CallToAction data={callToAction} />
</Base>
