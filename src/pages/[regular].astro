---
import Base from "@/layouts/Base.astro";
import MainContainer from "@/components/MainContainer.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getSingleEntry } from "@/lib/contentParser";
import { breadcrumbJsonLd, canonicalUrl, webPageJsonLd } from "@/lib/seo";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSingleEntry("pages");
  return pages.map((page) => ({
    params: { regular: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;

if (page.data.draft) return Astro.redirect("/404");

const { Content } = await render(page);
const { title, meta_title, description, image, page_header } = page.data;
// /elements is a demo/style-guide page with filler text (Star Trek
// placeholder copy), not real content — keep it out of the index. The
// sitemap filter in astro.config.mjs excludes it as well.
const isElements = page.id === "elements";
const canonical = canonicalUrl(Astro.url.pathname);
const breadcrumbs = [{ label: "Home", href: "/" }, { label: title }];
const pageJsonLd = isElements
  ? undefined
  : [
      webPageJsonLd({ name: title, description, canonical }),
      breadcrumbJsonLd(breadcrumbs),
    ];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  noindex={isElements}
  jsonLd={pageJsonLd}
>
  {page_header && <PageHeader page_header={page_header} />}
  <section>
    <MainContainer>
      <div class="container-padding-x container-padding-y">
        <div class="content">
          <Content />
        </div>
      </div>
    </MainContainer>
  </section>
</Base>
