---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import {
  canonicalUrl,
  isAbsoluteUrl,
  serializeJsonLd,
  toAbsoluteUrl,
} from "@/lib/seo";
import Footer from "@/partials/Footer.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "./partials/Header.astro";

const gtmEnabled = config.google_tag_manager?.enable;
const gtmId = config.google_tag_manager?.gtm_id;

// font families
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
  };
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  ogType = "website",
  jsonLd,
  article,
} = Astro.props;

const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
)
  .replace(/\s+/g, " ")
  .trim();
const pageDescription = plainify(
  description ? description : config.metadata.meta_description,
)
  .replace(/\s+/g, " ")
  .trim();
// Canonical is ALWAYS emitted: frontmatter override wins, else the
// current pathname resolved against base_url (no string surgery on it).
const canonicalHref = canonicalUrl(Astro.url.pathname, canonical);
// OG image: absolute URLs pass through verbatim; a local path that does
// not exist in /public/images (e.g. the placeholder image four -index.md
// files reference) falls back to the site default instead of emitting a
// 404 og:image.
const localImages = import.meta.glob(
  "/public/images/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
);
const rawImage = image ? image : config.metadata.meta_image;
const ogImage = toAbsoluteUrl(
  rawImage && !isAbsoluteUrl(rawImage) && !localImages[`/public${rawImage}`]
    ? config.metadata.meta_image
    : rawImage,
);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    {gtmEnabled && <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", gtmId);
    </script>}
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="powerai-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta charset="utf-8" />

    <!-- google font css -->
    {fontEntries.map(([key]) => {
      const cssVar = `--font-${key}` as any;
      return <Font cssVariable={cssVar} preload />;
    })}

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url (always emitted) -->
    <link rel="canonical" href={canonicalHref} itemprop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <!-- author -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content="en_US" />
    {ogType === "article" && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === "article" && article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === "article" && article?.author && (
      <meta property="article:author" content={article.author} />
    )}
    {ogType === "article" && article?.section && (
      <meta property="article:section" content={article.section} />
    )}

    <!-- twitter tags -->
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- og-image / twitter-image (absolute URLs pass through verbatim) -->
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- structured data: exactly one JSON-LD block per page -->
    {jsonLd && (
      <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    )}
    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
