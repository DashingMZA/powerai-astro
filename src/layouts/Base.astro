---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { defaultSeo, language, locale, site } from "@/config/site";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import {
  canonicalUrl,
  isAbsoluteUrl,
  serializeJsonLd,
  toAbsoluteUrl,
} from "@/lib/seo";
import Footer from "@/partials/Footer.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import Header from "./partials/Header.astro";

const gtmEnabled = config.google_tag_manager?.enable;
const gtmId = config.google_tag_manager?.gtm_id;

// font families
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
  };
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  ogType = "website",
  jsonLd,
  article,
} = Astro.props;

const pageTitle = plainify(meta_title ? meta_title : title ? title : site.title)
  .replace(/\s+/g, " ")
  .trim();
const pageDescription = plainify(
  description ? description : defaultSeo.description,
)
  .replace(/\s+/g, " ")
  .trim();
// Canonical is ALWAYS emitted: frontmatter override wins, else the
// current pathname resolved against base_url (no string surgery on it).
const canonicalHref = canonicalUrl(Astro.url.pathname, canonical);
// OG image: absolute URLs pass through verbatim; a local path that does
// not exist in /public/images (e.g. the placeholder image four -index.md
// files reference) falls back to the site default instead of emitting a
// 404 og:image.
const localImages = import.meta.glob(
  "/public/images/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
);
const rawImage = image ? image : defaultSeo.ogImage;
const ogImage = toAbsoluteUrl(
  rawImage && !isAbsoluteUrl(rawImage) && !localImages[`/public${rawImage}`]
    ? defaultSeo.ogImage
    : rawImage,
);
---

<!doctype html>
<html lang={language}>
  <head>
    <!-- Google Tag Manager (via @digi4care/astro-google-tagmanager; also
         pushes a virtualPageview on ClientRouter navigation) -->
    {gtmEnabled && <GoogleTagmanager id={gtmId} />}
    <!-- favicon -->
    <link rel="shortcut icon" href={site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="powerai-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta charset="utf-8" />

    <!-- google font css -->
    {fontEntries.map(([key]) => {
      const cssVar = `--font-${key}` as any;
      return <Font cssVariable={cssVar} preload />;
    })}

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url (always emitted) -->
    <link rel="canonical" href={canonicalHref} itemprop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <!-- author -->
    <meta name="author" content={defaultSeo.author} />

    <!-- og tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    {ogType === "article" && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === "article" && article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === "article" && article?.author && (
      <meta property="article:author" content={article.author} />
    )}
    {ogType === "article" && article?.section && (
      <meta property="article:section" content={article.section} />
    )}

    <!-- twitter tags -->
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- og-image / twitter-image (absolute URLs pass through verbatim) -->
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- structured data: exactly one JSON-LD block per page -->
    {jsonLd && (
      <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    )}
    <ClientRouter />
  </head>
  <body>
    <!-- Mermaid diagrams: only pages with a ```mermaid code block load the
         mermaid chunk (dynamic import); the block stays as plain code if
         rendering fails. Runs on every ClientRouter navigation. -->
    <script>
      async function renderMermaid() {
        const blocks = document.querySelectorAll("pre code.language-mermaid");
        if (!blocks.length) return;
        try {
          const mermaid = (await import("mermaid")).default;
          mermaid.initialize({ startOnLoad: false, theme: "dark" });
          for (const code of Array.from(blocks)) {
            const pre = code.parentElement;
            if (!pre) continue;
            const container = document.createElement("div");
            container.className = "mermaid-diagram";
            pre.replaceWith(container);
            const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
            const { svg } = await mermaid.render(id, code.textContent || "");
            container.innerHTML = svg;
          }
        } catch {
          // Leave the code block untouched on failure.
        }
      }
      document.addEventListener("astro:page-load", renderMermaid);
    </script>
    <!-- Google Tag Manager (noscript) -->
    {gtmEnabled && <GoogleTagmanagerNoscript id={gtmId} />}
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
