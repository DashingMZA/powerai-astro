---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

// Props interface for the component
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  fetchpriority?: "high" | "low" | "auto";
  style?: NonNullable<HTMLAttributes<"img">["style"]>;
}

// Destructuring Astro.props to get the component's props
const {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  fit,
  fetchpriority,
  style,
} = Astro.props;

// Absolute URLs (e.g. R2 / media.csofts.tech) must render verbatim —
// never prepend /public or the site domain to them.
const isAbsolute = /^(?:https?:)?\/\//i.test(src);
const isSvg = /\.svg(?:[?#]|$)/i.test(src) || format === "svg";

// Local paths live under /public/images; the glob keys are /public/... paths.
const localPath = isAbsolute
  ? null
  : src.startsWith("/public/")
    ? src
    : src.startsWith("/")
      ? `/public${src}`
      : `/public/${src}`;

// Glob pattern to load images from the /public/images folder
const images = import.meta.glob("/public/images/**/*.{jpeg,jpg,png,gif,svg}");

// SVGs and absolute URLs bypass astro:assets entirely: sharp cannot (and
// must not) process SVG, and remote images have no local file to optimise.
// A plain <img> renders them unchanged, which also fixes the build
// blocker (UnsupportedImageFormat for essential-features-2/3/4.svg).
const isValidPath = isAbsolute ? true : !!(localPath && images[localPath]);

// Log a warning message in yellow if the image is not found
if (!isValidPath) {
  console.warn(
    `\x1b[33mImage not found - ${src}.\x1b[0m Make sure the image is in the /public/images folder.`,
  );
}
---

{isValidPath && (isAbsolute || isSvg) && (
  <img
    src={isAbsolute ? src : src.replace(/^\/public/, "")}
    alt={alt}
    width={width}
    height={height}
    loading={loading ?? "lazy"}
    decoding={decoding ?? "async"}
    class={className}
    fetchpriority={fetchpriority}
    style={style}
  />
)}

{isValidPath && !isAbsolute && !isSvg && localPath && (
  <Image
    src={images[localPath]() as Promise<{ default: ImageMetadata }>}
    alt={alt}
    width={width}
    height={height}
    loading={loading ?? "lazy"}
    fit={fit ? fit : "contain"}
    decoding={decoding ?? "async"}
    class={className}
    format={format || "webp"}
    fetchpriority={fetchpriority}
    style={style}
    quality={"mid"}
  />
)}
