---
import { Icon } from "astro-icon/components";

interface ISocial {
  name: string;
  icon: string;
  link: string;
}
interface Props {
  source: ISocial[];
  className: string;
}
const { source, className } = Astro.props;

// Maps the `icon` keys in src/config/social.json to local astro-icon
// files in src/icons/ (same path data as the old inline SVG map, plus
// tiktok — which previously had no icon and rendered as plain text).
const iconMap: Record<string, string> = {
  FaFacebook: "facebook",
  FaXTwitter: "x",
  FaGithub: "github",
  FaLinkedin: "linkedin",
  FaInstagram: "instagram",
  FaTiktok: "tiktok",
};
---

<ul id={`social-${Math.random().toString(36).slice(2, 8)}`} class={className}>
  {source.map((social) => (
    <li class="inline-block" data-social-item>
      <a
        href={social.link}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="inline-block hover:scale-110 transition-transform duration-200"
      >
        <span class="sr-only">{social.name} (opens in new tab)</span>
        {iconMap[social.icon] ? (
          <Icon name={iconMap[social.icon]} width={20} height={20} />
        ) : (
          <span>{social.name}</span>
        )}
      </a>
    </li>
  ))}
</ul>

<script>
  import { animateMini as animate, inView } from "motion";
  function initSocialIcons() {
    document.querySelectorAll<HTMLElement>('[id^="social-"]').forEach((ul) => {
      ul.style.opacity = "0";
      ul.querySelectorAll<HTMLElement>("[data-social-item]").forEach((li) => {
        li.style.opacity = "0";
      });
      inView(ul, () => {
        animate(
          ul,
          { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
          { duration: 0.5, ease: "easeInOut" },
        );
        ul.querySelectorAll<HTMLElement>("[data-social-item]").forEach(
          (li, i) => {
            animate(
              li,
              {
                opacity: [0, 1],
                transform: ["translateY(20px)", "translateY(0)"],
              },
              { duration: 0.3, ease: "easeInOut", delay: i * 0.1 },
            );
          },
        );
      });
    });
  }
  document.addEventListener("astro:page-load", initSocialIcons);
</script>
