{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerai.csofts.tech/.sitepins/schema/pricing.json",
  "title": "pricing",
  "description": "Pricing page blocks. Single file: src/content/pricing/-index.md.",
  "x-sitepins": {
    "name": "pricing",
    "file": "src/content/pricing/-index.md",
    "fileType": "md",
    "fmType": "yaml",
    "contentPath": "src/content/pricing"
  },
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "og_image": {
      "type": "string"
    },
    "og_description": {
      "type": "string"
    },
    "twitter_title": {
      "type": "string"
    },
    "twitter_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "page_header": {
      "type": "object",
      "properties": {
        "badge": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "button_dark": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "button_primary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "button_secondary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "pricing_table": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "key"
            ]
          }
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "highlighted": {
                "type": "boolean"
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}
