{
  "name": "powerai-astro",
  "version": "1.0.2",
  "description": "Power AI - Astro theme",
  "author": "cSofts",
  "license": "MIT",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"astro dev\"",
    "build": "node scripts/themeGenerator.js && node scripts/jsonGenerator.js && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier -w ./src",
    "deploy:cf-workers": "pnpm run build && wrangler deploy",
    "preview:cf-workers": "pnpm run build && wrangler dev",
    "upload:r2": "node scripts/upload-to-r2.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "8.1.5",
    "@astrojs/react": "7.1.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "^11.0.21",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@digi4care/astro-google-tagmanager": "^2.1.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@playform/compress": "^0.2.5",
    "@supercharge/promise-pool": "^3.3.0",
    "astro": "7.4.11",
    "astro-auto-import": "^0.6.0",
    "astro-icon": "^1.2.0",
    "astro-swiper": "^2.11.0",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "exif-be-gone": "^1.5.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "i18n": "^0.15.4",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "motion": "^14.13.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.161.0"
  }
}
