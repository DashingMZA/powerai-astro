{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerai.csofts.tech/.sitepins/schema/contact.json",
  "title": "contact",
  "description": "Contact page blocks. Single file: src/content/contact/-index.md.",
  "x-sitepins": {
    "name": "contact",
    "file": "src/content/contact/-index.md",
    "fileType": "md",
    "fmType": "yaml",
    "contentPath": "src/content/contact"
  },
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "og_image": {
      "type": "string"
    },
    "og_description": {
      "type": "string"
    },
    "twitter_title": {
      "type": "string"
    },
    "twitter_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "page_header": {
      "type": "object",
      "properties": {
        "badge": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "button_dark": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "button_primary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "button_secondary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "contact_info": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "title"
  ]
}
