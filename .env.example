# PowerAI form backends (Resend) — copy to `.env` and fill in real values.
# NEVER commit a filled-in `.env`: `.gitignore` ignores `.env*` files.
# All values below come from the site owner — none are invented here.
# Without them the contact / newsletter / apply endpoints answer 503
# ("not set up yet") and send nothing. See the release report for the
# setup steps (Resend API key, verified sender domain, inbox address).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact messages and job applications.
CONTACT_EMAIL=

# Verified sender address on the Resend domain, e.g.
# "Power AI <hello@powerai.jadoo.bond>".
# Must be a domain verified in Resend, or sending fails.
CONTACT_FROM_EMAIL=

# Sender for newsletter mail. Only needed if a welcome/confirmation
# email is added later; the newsletter endpoint today only creates a
# Resend contact and sends no email, so this may stay empty.
NEWSLETTER_FROM_EMAIL=

# Optional: Resend segment id to attach new newsletter contacts to.
# Leave empty to create contacts without a segment.
RESEND_NEWSLETTER_SEGMENT_ID=
